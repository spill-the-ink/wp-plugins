{
  "name": "wp-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "build": "npm run build-plugins",
    "build:plugin:wp-seo": "node tools/copy-php.js && vite build --mode wp-seo",
    "build:plugin:wp-calendar": "yarn --cwd plugins/wp-calendar run build:pot && yarn --cwd plugins/wp-calendar run build:lang && yarn --cwd plugins/wp-calendar run build && node tools/copy-php.js",
    "build-plugins": "npm run build:plugin:wp-seo && npm run build:plugin:wp-calendar",
    "release": "npm run build-plugins && node tools/release.js"
  },  
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "fs-extra": "^11.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.4",
    "@tailwindcss/postcss": "^4.1.4",
    "typescript": "^5.6.3",
    "vite": "^8.0.0"
  }
}
